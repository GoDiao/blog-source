---
import BaseLayout from '../layouts/BaseLayout.astro';
import I18nData from '../components/I18nData.astro';

const projects = [
  {
    name: 'dreamcoder',
    url: 'https://github.com/GoDiao/dreamcoder',
    desc: 'An open-source desktop GUI for Claude Code — native programming workbench with session management, integrated terminal, and multi-provider support.',
    descKey: 'proj.dreamcoder.desc',
    tags: ['Tauri', 'React', 'AI', 'Desktop'],
    year: '2026',
    img: '/projects/dreamcoder.png',
    stars: 51,
  },
  {
    name: 'ai-interview-agent',
    url: 'https://github.com/GoDiao/ai-interview-agent',
    desc: 'AI-powered interview preparation with structured questioning and feedback loops.',
    descKey: 'proj.ai-interview.desc',
    tags: ['Python', 'NLP', 'Agent'],
    year: '2026',
    img: '/projects/ai-interview-agent.png',
    stars: 23,
  },
  {
    name: 'Freeway',
    url: 'https://github.com/GoDiao/Free-Way',
    desc: 'Use Claude Code, Codex, OpenCode, Cline for free — one local gateway to 14+ free LLM providers. OpenAI & Anthropic compatible.',
    descKey: 'proj.freeway.desc',
    tags: ['TypeScript', 'LLM', 'API'],
    year: '2026',
    img: '/projects/free_way.jpg',
    stars: 21,
  },
  {
    name: 'openkb',
    url: 'https://github.com/GoDiao/openkb',
    desc: 'Centralized Agent Kanban for multi-agent workflows — agents sync via CLI, humans track Spec/Plan/roadmap in a web hub with kanban boards.',
    descKey: 'proj.openkb.desc',
    tags: ['Python', 'Agent', 'Kanban'],
    year: '2026',
    img: '/projects/openkb.png',
    stars: 1,
  },
  {
    name: 'Iris',
    url: 'https://github.com/GoDiao/Open-Agent-in-Browser',
    desc: 'A Chrome extension bringing persistent AI assistant to your browser — with memory, DOM automation, network control, and 60+ tools.',
    descKey: 'proj.iris.desc',
    tags: ['TypeScript', 'Chrome Extension', 'Agent'],
    year: '2026',
    img: '/projects/iris.png',
    stars: 0,
  },
  {
    name: 'Paper-Reader',
    url: 'https://github.com/GoDiao/Paper-Reader',
    desc: 'Hierarchical multi-agent academic paper analysis system with interactive web interface.',
    descKey: 'proj.paper-reader.desc',
    tags: ['Python', 'Multi-Agent', 'LLM'],
    year: '2025',
    img: '/projects/paper_reader.png',
    stars: 4,
  },
  {
    name: 'oc-loop',
    url: 'https://github.com/GoDiao/oc-loop',
    desc: 'Resumable loop plugin for opencode — persistent iterative agent workflows.',
    descKey: 'proj.oc-loop.desc',
    tags: ['TypeScript', 'CLI', 'Agent'],
    year: '2026',
    img: '/projects/oc-loop.jpg',
    stars: 2,
  },
];

const oss = [
  {
    name: 'paperclip',
    url: 'https://github.com/paperclipai/paperclip',
    desc: 'AI agent orchestration framework for building autonomous, zero-human companies — multi-agent negotiation, task dispatching, and execution monitoring.',
    descKey: 'oss-page.paperclip.desc',
    img: '/oss/paperclip.png',
    stars: 69182,
  },
  {
    name: 'claude-context',
    url: 'https://github.com/zilliztech/claude-context',
    desc: 'Code search MCP for Claude Code — make entire codebase the context for any coding agent.',
    descKey: 'oss-page.claude-context.desc',
    img: '/oss/claude-context.png',
    stars: 11714,
  },
  {
    name: 'open-codesign',
    url: 'https://github.com/OpenCoworkAI/open-codesign',
    desc: 'Open-source Claude Design alternative. One-click import your Claude Code / Codex API key. Prompt → prototype / slides / PDF. Multi-model, BYOK, local-first, MIT.',
    descKey: 'oss-page.open-codesign.desc',
    img: '/oss/open-codesign.png',
    stars: 6672,
  },
  {
    name: 'opensre',
    url: 'https://github.com/Tracer-Cloud/opensre',
    desc: 'Open-source framework for AI SRE agents — 60+ integrations for incident investigation, root-cause analysis, and automated remediation.',
    descKey: 'oss-page.opensre.desc',
    img: '/oss/opensre.png',
    stars: 6419,
  },
  {
    name: 'optillm',
    url: 'https://github.com/algorithmicsuperintelligence/optillm',
    desc: 'Optimizing inference proxy for LLMs with pluggable approaches — MoA, CoT, MCTS, and auto context compression plugin.',
    descKey: 'oss-page.optillm.desc',
    img: '/oss/optillm.png',
    stars: 4128,
  },
  {
    name: 'investing-algorithm-framework',
    url: 'https://github.com/coding-kitties/investing-algorithm-framework',
    desc: 'Framework for developing and backtesting automated trading strategies — backtest engine, indicator computation, and deployment pipeline.',
    descKey: 'oss-page.investing.desc',
    img: '/oss/investing-framework.png',
    stars: 1239,
  },
  {
    name: 'MiniCode',
    url: 'https://github.com/LiuMengxuan04/MiniCode',
    desc: 'Terminal-native AI coding assistant with Claude Code-style workflow and lightweight TUI — built for rapid prototyping and code review.',
    descKey: 'oss-page.minicode.desc',
    img: '/oss/minicode.jpg',
    stars: 794,
  },
];
---

<BaseLayout title="Projects — Diao Shengjia">
  <I18nData />
  <main>
    <section class="page-intro">
      <h1 class="intro-h reveal" data-i18n="projects.title">Projects</h1>
      <p class="intro-sub reveal" data-i18n="projects.subtitle">Things I've built</p>
    </section>

    <!-- ── Featured ── -->
    <section class="section">
      <h2 class="section-h reveal" data-i18n="projects.featured">Featured</h2>
      <div class="proj-list">
        {projects.map((p, i) => (
          <a href={p.url} target="_blank" rel="noopener" class="proj-row reveal" style="--pi:{i}">
            <div class="proj-thumb">
              <img src={p.img} alt={p.name} class="proj-img" loading="lazy" />
            </div>
            <div class="proj-body">
              <div class="proj-top">
                <h3 class="proj-name">{p.name}</h3>
                <span class="proj-stars">&#9733; {p.stars}</span>
              </div>
              <p class="proj-desc" data-i18n={p.descKey}>{p.desc}</p>
              <div class="proj-bottom">
                <div class="proj-tags">
                  {p.tags.map((tag) => <span class="proj-tag">{tag}</span>)}
                </div>
                <span class="proj-year">{p.year}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ── OSS ── -->
    <section class="section">
      <h2 class="section-h reveal" data-i18n="projects.oss">Open Source Projects I Contribute</h2>
      <div class="oss-grid">
        {oss.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="oss-card reveal">
            <div class="oss-img-wrap">
              <img src={p.img} alt="" class="oss-img" loading="lazy" />
            </div>
            <div class="oss-body">
              <span class="oss-name">{p.name}</span>
              <span class="oss-desc" data-i18n={p.descKey}>{p.desc}</span>
              <span class="oss-stars">&#9733; {p.stars.toLocaleString()}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-intro {
    padding: 4rem 0 3rem;
  }
  .intro-h {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 6vw, 3.8rem);
    font-weight: 350;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }
  .intro-sub {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .section { padding: 3.5rem 0; }
  .section + .section { border-top: 1px solid var(--border); }

  /* ── Project List (image left, text right, scalable) ── */
  .proj-list { display: flex; flex-direction: column; }
  .proj-row {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem 0;
    transition: all var(--transition);
    align-items: start;
  }
  .proj-row + .proj-row { border-top: 1px solid var(--border); }
  .proj-row:hover {
    padding-left: 0.5rem;
  }

  .proj-thumb {
    width: 260px;
    height: 150px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-elevated);
    flex-shrink: 0;
    border: 1px solid var(--border);
    transition: border-color var(--transition);
  }
  .proj-row:hover .proj-thumb { border-color: var(--border-hover); }
  .proj-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .proj-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-top: 0.1rem;
  }
  .proj-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .proj-name {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 400;
    color: var(--text);
    transition: color var(--transition);
  }
  .proj-row:hover .proj-name { color: var(--accent); }
  .proj-stars {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    opacity: 0.55;
    flex-shrink: 0;
  }
  .proj-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.6rem;
    flex: 1;
  }
  .proj-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }
  .proj-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .proj-tag {
    font-family: var(--mono);
    font-size: 0.5rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition);
    border-radius: 2px;
  }
  .proj-row:hover .proj-tag { border-color: var(--border-hover); color: var(--text-secondary); }
  .proj-year {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  /* ── OSS (3-column grid, last row centered) ── */
  .oss-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--border);
  }
  .oss-grid::after {
    content: '';
    flex: 1 1 calc(33.333% - 1px);
    background: var(--bg);
  }
  .oss-card {
    flex: 1 1 calc(33.333% - 1px);
    min-width: calc(33.333% - 1px);
    background: var(--bg);
    transition: background var(--transition);
  }
  .oss-card:hover { background: var(--bg-elevated); }
  .oss-img-wrap {
    height: 120px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .oss-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .oss-card:hover .oss-img { transform: scale(1.03); }
  .oss-body { padding: 1.25rem 1.5rem 1.5rem; }
  .oss-name {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text);
    transition: color var(--transition);
    display: block;
    margin-bottom: 0.15rem;
  }
  .oss-card:hover .oss-name { color: var(--accent); }
  .oss-desc {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .oss-stars {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.58rem;
    color: var(--accent);
    opacity: 0.45;
  }
  .oss-card:hover .oss-stars { opacity: 0.75; }

  @media (max-width: 768px) {
    .proj-row { gap: 1rem; }
    .proj-thumb { width: 180px; height: 110px; }
    .oss-card { flex: 1 1 100%; min-width: 100%; }
  }
  @media (max-width: 640px) {
    .page-intro { padding: 3rem 0 2rem; }
    .intro-h { font-size: clamp(2rem, 7vw, 2.8rem); }
    .proj-row { flex-direction: column; gap: 0.75rem; }
    .proj-row:hover { padding-left: 0; }
    .proj-thumb { width: 100%; height: 180px; }
    .section { padding: 2.5rem 0; }
  }
</style>

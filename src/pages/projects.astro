---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: 'Paper-Reader',
    url: 'https://github.com/GoDiao/Paper-Reader',
    desc: 'Hierarchical multi-agent academic paper analysis system with an interactive web interface.',
  },
  {
    name: 'ai-interview-agent',
    url: 'https://github.com/GoDiao/ai-interview-agent',
    desc: 'AI-powered interview preparation agent with structured questioning and feedback loops.',
  },
  {
    name: 'Freeway',
    url: 'https://github.com/GoDiao/Freeway',
    desc: 'Open-source gateway aggregating free LLM APIs behind one local, OpenAI-compatible endpoint.',
  },
  {
    name: 'oc-loop',
    url: 'https://github.com/GoDiao/oc-loop',
    desc: 'Resumable loop plugin for opencode with /oc-loop and /oc-watch for iterative agent workflows.',
  },
];

const oss = [
  {
    name: 'paperclip',
    url: 'https://github.com/SolomonAIEngineering/paperclip',
    desc: 'Open-source orchestration for zero-human companies.',
  },
  {
    name: 'MiniCode',
    url: 'https://github.com/Gen-Verse/MiniCode',
    desc: 'Lightweight terminal coding assistant with Claude Code-like workflow and TUI architecture.',
  },
  {
    name: 'investing-algorithm-framework',
    url: 'https://github.com/codingwithmanny/investing-algorithm-framework',
    desc: 'Framework for developing, backtesting, and deploying automated trading algorithms.',
  },
];
---

<BaseLayout title="Projects - Diao Shengjia">
  <main>
    <h1>Projects</h1>

    <h2>Featured Builds</h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={p.url}>
          <h3>{p.name}</h3>
          <p>{p.desc}</p>
        </a>
      ))}
    </div>

    <h2>Open Source Contributions</h2>
    <div class="grid">
      {oss.map((p) => (
        <a class="card" href={p.url}>
          <h3>{p.name}</h3>
          <p>{p.desc}</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  h1 { font-size: 2rem; margin-bottom: 1rem; }
  h2 { font-size: 1.3rem; margin: 2rem 0 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s;
    color: var(--text);
  }
  .card:hover { border-color: var(--accent); text-decoration: none; }
  .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .card p { font-size: 0.9rem; color: var(--text-secondary); }
</style>

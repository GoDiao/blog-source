---
import BaseLayout from '../layouts/BaseLayout.astro';

const research = [
  { label: 'Computer Vision', detail: 'RAW reconstruction · Inverse ISP' },
  { label: 'Agentic AI', detail: 'Multi-agent architectures' },
  { label: 'Embodied Intelligence', detail: 'VLA models · SpatialVLA' },
  { label: 'LLM Systems', detail: 'vLLM · KV cache · Ascend 910B' },
];

const experience = [
  {
    role: 'Algorithm Research Engineer',
    org: 'Huawei Singapore',
    period: 'Jul 2025 – Dec 2025',
    directions: ['RGB to RAW', 'VLA', 'KV Cache System', 'Agentic AI'],
  },
  {
    role: 'Chip Verification Engineer',
    org: 'Infineon Technologies',
    period: 'Dec 2022 – Jul 2023',
    directions: ['Chip Verification', 'Tcl/Python Automation'],
  },
  {
    role: 'Implementation Engineer',
    org: 'Kingdee International',
    period: 'May 2024 – Jul 2024',
    directions: ['ERP System Implementation', 'Data Automation'],
  },
];

const education = [
  { degree: 'M.Sc. EEE', school: 'Nanyang Technological University', period: '2024 — 2026', note: 'Highest Distinction' },
  { degree: 'B.Eng. EEE', school: 'Nanyang Technological University', period: '2020 — 2024', note: 'SM2 Scholarship' },
];

const timeline = [
  { date: '2025.01', text: 'Huawei Outstanding R&D Contribution Award' },
  { date: '2024.12', text: 'WSDM Cup — ranked 154 / 950' },
  { date: '2024.08', text: 'EEE Global Merit Award, S$5,000 scholarship' },
];

const oss = [
  { name: 'paperclip', url: 'https://github.com/paperclipai/paperclip', desc: 'AI agent orchestration framework for building autonomous, zero-human companies', stars: 58758 },
  { name: 'MiniCode', url: 'https://github.com/LiuMengxuan04/MiniCode', desc: 'Terminal-native AI coding assistant with lightweight TUI', stars: 503 },
  { name: 'investing-algorithm-framework', url: 'https://github.com/coding-kitties/investing-algorithm-framework', desc: 'Framework for developing and backtesting automated trading strategies', stars: 947 },
];
---

<BaseLayout title="Diao Shengjia">
  <main>
    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="hero-avatar reveal">
        <img src="/avatar.jpg" alt="Diao Shengjia" class="avatar-img" />
      </div>
      <h1 class="hero-name reveal">Diao Shengjia</h1>
      <p class="hero-role reveal">AI/ML Researcher &middot; NTU Singapore</p>
      <p class="hero-status reveal">
        <span class="status-ring"></span>
        Available for opportunities
      </p>
      <div class="hero-icons reveal">
        <a href="mailto:diaoshengjia@gmail.com" class="hi-link" title="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
        </a>
        <a href="https://github.com/GoDiao" target="_blank" rel="noopener" class="hi-link" title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/shengjia-diao-800964222/" target="_blank" rel="noopener" class="hi-link" title="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </section>

    <!-- ── Research ── -->
    <section class="section">
      <h2 class="section-h reveal">Research</h2>
      <div class="research-grid">
        {research.map((r, i) => (
          <div class="rc-card" style="--ri:{i}">
            <h3 class="rc-label">{r.label}</h3>
            <p class="rc-detail">{r.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Bio ── -->
    <section class="section">
      <p class="bio reveal">
        AI/ML researcher at <strong>NTU Singapore</strong> (M.Sc. EEE, Highest Distinction).
        Previously B.Eng. from NTU with SM2 Scholarship. Working across computer vision,
        LLM systems, and embodied intelligence at <strong>Huawei Singapore</strong>.
      </p>
    </section>

    <!-- ── Experience (Timeline) ── -->
    <section class="section">
      <h2 class="section-h reveal">Experience</h2>
      <div class="timeline">
        {experience.map((exp, i) => (
          <div class="tl-entry reveal" style="--ti:{i}">
            <div class="tl-marker">
              <span class="tl-dot"></span>
              {i < experience.length - 1 && <span class="tl-line"></span>}
            </div>
            <div class="tl-card">
              <div class="tl-head">
                <div>
                  <h3 class="tl-role">{exp.role}</h3>
                  <span class="tl-org">{exp.org}</span>
                </div>
                <span class="tl-period">{exp.period}</span>
              </div>
              <ul class="tl-highlights">
                {exp.directions.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Education + Timeline ── -->
    <section class="section">
      <div class="two-col">
        <div>
          <h2 class="section-h reveal">Education</h2>
          <div class="edu-list">
            {education.map((edu, i) => (
              <div class="edu-item reveal" style="--ei:{i}">
                <span class="edu-degree">{edu.degree}</span>
                <span class="edu-school">{edu.school}</span>
                <span class="edu-period">{edu.period} &middot; {edu.note}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="section-h reveal">Timeline</h2>
          <div class="tl-list">
            {timeline.map((t, i) => (
              <div class="tl-row reveal" style="--ti:{i}">
                <span class="tl-date">{t.date}</span>
                <span class="tl-text">{t.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Open Source ── -->
    <section class="section">
      <h2 class="section-h reveal">Open Source Projects I Contribute</h2>
      <div class="oss-list">
        {oss.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="oss-row reveal">
            <span class="oss-name">{p.name}</span>
            <span class="oss-stars">&#9733; {p.stars.toLocaleString()}</span>
            <span class="oss-desc">{p.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Links ── -->
    <section class="section">
      <div class="links-row">
        <a href="/projects" class="link-card reveal">
          <span class="lc-label">Projects</span>
          <span class="lc-desc">Things I've built</span>
        </a>
        <a href="https://godiao.github.io/blog/" class="link-card reveal">
          <span class="lc-label">Blog</span>
          <span class="lc-desc">Thoughts & notes</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 4.5rem 0 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,149,106,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-avatar {
    width: 112px; height: 112px;
    margin: 0 auto 2rem;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid var(--border-hover);
    position: relative;
  }
  .hero-avatar::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,149,106,0.15) 0%, transparent 60%);
    z-index: -1;
  }
  .avatar-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-name {
    font-family: var(--serif);
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 350;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }
  .hero-role {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 350;
    margin-bottom: 0.75rem;
  }
  .hero-status {
    font-family: var(--mono);
    font-size: 0.58rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .status-ring {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }
  .hero-icons {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .hi-link {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    transition: all var(--transition);
  }
  .hi-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }
  .hi-link svg { width: 15px; height: 15px; }

  /* ── Section ── */
  .section { padding: 3.5rem 0; }
  .section + .section { border-top: 1px solid var(--border); }

  /* ── Research ── */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
  }
  .rc-card {
    background: var(--bg);
    padding: 1.75rem 1.5rem;
    transition: all 0.3s ease;
    position: relative;
  }
  .rc-card:hover {
    background: var(--bg-elevated);
  }
  .rc-label {
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 0.3rem;
    transition: color var(--transition);
  }
  .rc-card:hover .rc-label { color: var(--accent); }
  .rc-detail {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  /* ── Bio ── */
  .bio {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 620px;
  }
  .bio strong { color: var(--text); font-weight: 500; }

  /* ── Timeline ── */
  .timeline { display: flex; flex-direction: column; gap: 0; }
  .tl-entry { display: flex; gap: 1.5rem; }
  .tl-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 12px;
    flex-shrink: 0;
    padding-top: 0.35rem;
  }
  .tl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.35;
    flex-shrink: 0;
  }
  .tl-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin-top: 0.4rem;
  }
  .tl-card {
    flex: 1;
    padding-bottom: 2rem;
  }
  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .tl-role {
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--text);
    margin-bottom: 0.05rem;
  }
  .tl-org {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .tl-period {
    font-family: var(--mono);
    font-size: 0.58rem;
    color: var(--text-dim);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
  .tl-highlights {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }
  .tl-highlights li {
    font-size: 0.78rem;
    color: var(--text-secondary);
    padding: 0.15rem 0.55rem;
    background: var(--bg-elevated);
    border-radius: 3px;
    line-height: 1.5;
  }

  /* ── Education + Timeline 2-col ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .edu-item {
    padding: 0.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .edu-item + .edu-item { border-top: 1px solid var(--border); }
  .edu-degree {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text);
  }
  .edu-school {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }
  .edu-period { font-size: 0.78rem; color: var(--text-secondary); }

  .tl-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 0;
  }
  .tl-row + .tl-row { border-top: 1px solid var(--border); }
  .tl-date {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    min-width: 4.5rem;
    letter-spacing: 0.03em;
  }
  .tl-text { font-size: 0.88rem; color: var(--text); }

  /* ── Open Source (clean list, no borders) ── */
  .oss-list { display: flex; flex-direction: column; }
  .oss-row {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.9rem 0;
    transition: all var(--transition);
  }
  .oss-row + .oss-row { border-top: 1px solid var(--border); }
  .oss-row:hover { padding-left: 0.5rem; }
  .oss-name {
    font-family: var(--serif);
    font-size: 0.92rem;
    font-style: italic;
    color: var(--text);
    transition: color var(--transition);
  }
  .oss-row:hover .oss-name { color: var(--accent); }
  .oss-stars {
    font-family: var(--mono);
    font-size: 0.56rem;
    color: var(--accent);
    opacity: 0.45;
    flex-shrink: 0;
  }
  .oss-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* ── Links ── */
  .links-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
  }
  .link-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.75rem;
    background: var(--bg);
    transition: background var(--transition);
    min-height: 100px;
  }
  .link-card:hover { background: var(--bg-elevated); }
  .lc-label {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 400;
    transition: color var(--transition);
  }
  .link-card:hover .lc-label { color: var(--accent); }
  .lc-desc {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    margin-top: 0.2rem;
  }

  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr; gap: 2rem; }
    .tl-head { flex-direction: column; gap: 0.1rem; }
    .oss-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
  @media (max-width: 640px) {
    .hero { padding: 3.5rem 0 3rem; }
    .hero-name { font-size: clamp(2.2rem, 8vw, 3.5rem); }
    .research-grid { grid-template-columns: repeat(2, 1fr); }
    .links-row { grid-template-columns: 1fr; }
    .section { padding: 2.5rem 0; }
    .tl-card { padding-bottom: 1.5rem; }
  }
</style>

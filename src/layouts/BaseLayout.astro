---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Diao Shengjia — AI/ML Researcher @ NTU Singapore. Computer Vision, LLM Systems, Agentic AI." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⟟</text></svg>" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <canvas id="particles" aria-hidden="true"></canvas>
    <nav>
      <a href="/" class="logo">DS</a>
      <div class="nav-links">
        <a href="/about">About</a>
        <a href="/projects">Projects</a>
        <a href="https://godiao.github.io/blog/">Blog</a>
        <a href="https://github.com/GoDiao" target="_blank" rel="noopener">GitHub</a>
      </div>
    </nav>
    <slot />
    <footer>
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} Diao Shengjia</span>
        <span class="footer-sep">&mdash;</span>
        <a href="mailto:diaoshengjia@gmail.com">diaoshengjia@gmail.com</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f0f0e;
    --bg-elevated: #151513;
    --bg-card: #191916;
    --text: #d4cfc6;
    --text-secondary: #7c766c;
    --text-dim: #3e3b35;
    --accent: #b8956a;
    --accent-dim: rgba(184, 149, 106, 0.06);
    --accent-soft: rgba(184, 149, 106, 0.12);
    --border: #1e1d1a;
    --border-hover: #2c2a25;
    --sans: 'DM Sans', -apple-system, sans-serif;
    --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --mono: 'JetBrains Mono', monospace;
    --max-width: 880px;
    --transition: 0.25s ease;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    font-size: 115%;
    scrollbar-width: thin;
    scrollbar-color: var(--border-hover) transparent;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    font-weight: 350;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  ::selection {
    background: var(--accent);
    color: #fff;
  }

  a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition);
  }
  a:hover { color: var(--accent); }

  /* ── Particle Canvas ── */
  #particles {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
  }

  /* ── Nav ── */
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .logo {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }
  .nav-links a { color: var(--text-secondary); }
  .nav-links a:hover { color: var(--text); }

  /* ── Main ── */
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    flex: 1;
    position: relative;
    z-index: 10;
  }

  /* ── Footer ── */
  footer {
    padding: 2.5rem 1.5rem 3rem;
    margin-top: 5rem;
    position: relative;
    z-index: 10;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--text-dim);
  }
  .footer-sep { color: var(--border); }
  .footer-inner a { color: var(--text-dim); }
  .footer-inner a:hover { color: var(--accent); }

  /* ── Shared heading ── */
  .section-h {
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-dim);
    margin-bottom: 1.75rem;
  }

  /* ── Scroll Reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.revealed { opacity: 1; transform: translateY(0); }

  @media (max-width: 640px) {
    .nav-links { gap: 1rem; font-size: 0.72rem; }
    nav { padding: 1rem; }
    main { padding: 0 1rem; }
    footer { padding: 2rem 1rem; margin-top: 3rem; }
  }
</style>

<script>
  (function() {
    // ── Particle Canvas ──
    const canvas = document.getElementById('particles');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, particles = [];

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const count = Math.min(80, Math.floor((w * h) / 12000));
    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 0.8 + 0.3,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        alpha: Math.random() * 0.35 + 0.1,
      });
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w; if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h; if (p.y > h) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(184,149,106,${p.alpha})`;
        ctx.fill();
      }
      // draw subtle connections between nearby particles
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(184,149,106,${0.03 * (1 - dist / 100)})`;
            ctx.lineWidth = 0.3;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(draw);
    }
    draw();

    // ── Scroll Reveal ──
    const revealEls = document.querySelectorAll('.reveal');
    if (!revealEls.length) return;
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry, i) {
        if (entry.isIntersecting) {
          setTimeout(function() { entry.target.classList.add('revealed'); }, i * 50);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -20px 0px' });
    revealEls.forEach(function(el) { observer.observe(el); });
  })();
</script>
